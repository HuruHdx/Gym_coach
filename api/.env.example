# 评测 / 脚本用的机器口令（前端登录已改为手机号+密码，不再用这个）
APP_TOKEN=dev-token
# 用户 JWT 签名密钥（生产必改；空则用 APP_TOKEN 派生）
JWT_SECRET=
JWT_EXPIRE_DAYS=30
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
# 意图改写：llm=仅模型（失败才回落规则）；hybrid=模型+规则盖写；rules=仅规则
INTENT_REWRITE_MODE=llm
# same=与主 LLM 共用；off=关掉模型改写。后续可单独接轻量意图模型
INTENT_REWRITE_PROVIDER=same
DATABASE_URL=postgresql+psycopg://postgres:改成你的密码@127.0.0.1:5432/gym_coach
MEMORY_TOKEN_BUDGET=1800
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# 后台 gym-admin 登录口令；空则回落到 APP_TOKEN
ADMIN_PASSWORD=
# 可观测：true 且填了 key 后，聊天图会出现在 LangSmith 项目里
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Gym_coach

# ---------- 公共资源存储（封面 / 小 MP4）----------
# local（默认）：写 api/static/，返回 /static/...；本机联调够用，不必配下面 S3_*
# s3：Cloudflare R2 / 七牛 / OSS 等 S3 兼容；封装 App/小程序前建议切过去
STORAGE_BACKEND=local
# --- 仅 STORAGE_BACKEND=s3 时需要 ---
# Cloudflare R2 示例：
#   1) dash.cloudflare.com → R2 → Create bucket（如 gym-assets）
#   2) Manage R2 API Tokens → Create API token（Object Read & Write）
#   3) 桶设置 → Settings → Public access：绑自定义域名，或开 r2.dev 公开域名
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=gym-assets
# S3_PUBLIC_BASE_URL=https://cdn.你的域名.com
# S3_REGION=auto
