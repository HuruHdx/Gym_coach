# 评测 / 脚本用的机器口令（前端登录已改为手机号+密码，不再用这个）
APP_TOKEN=dev-token
# 用户 JWT 签名密钥（生产必改；空则用 APP_TOKEN 派生）
JWT_SECRET=
JWT_EXPIRE_DAYS=30
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
# 意图改写：llm=仅模型（失败才回落规则）；hybrid=模型+规则盖写；rules=仅规则
INTENT_REWRITE_MODE=llm
# same=与主 LLM 共用；off=关掉模型改写。后续可单独接轻量意图模型
INTENT_REWRITE_PROVIDER=same
DATABASE_URL=postgresql+psycopg://postgres:改成你的密码@127.0.0.1:5432/gym_coach
MEMORY_TOKEN_BUDGET=1800
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 可观测：true 且填了 key 后，聊天图会出现在 LangSmith 项目里
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Gym_coach
