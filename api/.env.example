APP_TOKEN=dev-token
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
# 意图改写：hybrid=模型+规则兜底；rules=仅规则；llm=仅模型（失败回落规则）
INTENT_REWRITE_MODE=hybrid
# same=与主 LLM 共用；off=关掉模型改写。后续可单独接轻量意图模型
INTENT_REWRITE_PROVIDER=same
DATABASE_URL=postgresql+psycopg://postgres:改成你的密码@127.0.0.1:5432/gym_coach
MEMORY_TOKEN_BUDGET=1800
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
